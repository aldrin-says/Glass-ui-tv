<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid-glass tile. Focused = brighter glass + white ring. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <gradient
                        android:angle="270"
                        android:endColor="#33FFFFFF"
                        android:startColor="#70FFFFFF" />
                    <stroke
                        android:width="3dp"
                        android:color="#FFFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <gradient
                        android:angle="270"
                        android:endColor="#14FFFFFF"
                        android:startColor="#40FFFFFF" />
                    <stroke
                        android:width="1dp"
                        android:color="#55FFFFFF" />
                </shape>
            </item>
            <!-- soft specular highlight along the top edge -->
            <item
                android:left="1dp"
                android:right="1dp"
                android:top="1dp"
                android:gravity="top">
                <shape android:shape="rectangle">
                    <corners
                        android:topLeftRadius="17dp"
                        android:topRightRadius="17dp" />
                    <size android:height="34dp" />
                    <gradient
                        android:angle="270"
                        android:endColor="#00FFFFFF"
                        android:startColor="#2EFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
